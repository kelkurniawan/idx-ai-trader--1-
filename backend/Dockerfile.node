# ---------------------------------------------------------------------------
# Node.js News Microservice Dockerfile
# ---------------------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
COPY prisma ./prisma/

# Install dependencies (including dev deps for building)
RUN npm install

# Generate Prisma client
RUN npx prisma generate

# Copy the rest of the source code
COPY . .

# Build typescript
RUN npm run build

# --- Production Image ---
FROM node:20-alpine

WORKDIR /app

# Copy built artifacts and dependencies
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

EXPOSE 3001

# Startup:
#  1. Normalize DATABASE_URL for Prisma. Prisma only accepts postgresql:// /
#     postgres://; strip a SQLAlchemy-style "+asyncpg" suffix if present so the
#     same Neon connection string works for either backend.
#  2. Sync the Prisma-owned tables with `db push`. This is a SHARED database
#     (Python owns users/sessions; Prisma owns news_sources/news_items/
#     agent_runs/user_personalizations). `migrate deploy` fails with P3005 on a
#     non-empty shared schema, whereas `db push` creates only the tables in the
#     Prisma schema and leaves the Python-owned tables untouched.
#  3. Start the server.
CMD ["sh", "-c", "export DATABASE_URL=$(printf '%s' \"$DATABASE_URL\" | sed -e 's|postgresql+asyncpg://|postgresql://|') && npx prisma db push --skip-generate && node dist/server.js"]
