# ═══════════════════════════════════════════════════════════════
# Free-Tier Deployment Env Reference  (Vercel + Render + Neon + Upstash)
# ═══════════════════════════════════════════════════════════════
#
# This repo deploys as TWO SEPARATE Render web services that share one
# Neon database and one Upstash Redis. Each service has its OWN env block —
# do NOT paste both into the same service.
#
#   Service 1: sahamgue-api    (Python / FastAPI)  — Dockerfile.python, port 8000
#   Service 2: sahamgue-news   (Node.js / Express) — Dockerfile.node,   port 3001
#
# Providers (all free tier):
#   Database : Neon     https://neon.tech
#   Redis    : Upstash  https://upstash.com
#   Email    : Resend   https://resend.com
#   Auth     : Clerk    https://clerk.com
#   AI (Py)  : Gemini   https://aistudio.google.com
#   AI (Node): Groq     https://console.groq.com
#
# ───────────────────────────────────────────────────────────────
# ⚠️  DATABASE_URL: the two services need DIFFERENT formats
# ───────────────────────────────────────────────────────────────
#   Python (SQLAlchemy/asyncpg): postgresql://...        ← code converts to asyncpg
#   Node   (Prisma):             postgresql://...
#
#   Both MUST use the Neon DIRECT endpoint (host WITHOUT "-pooler").
#   - Prisma `migrate deploy` cannot acquire its migration lock through
#     Neon's PgBouncer pooler — use the direct endpoint.
#   - asyncpg rejects libpq params (sslmode, channel_binding); database.py
#     strips them automatically, so `?sslmode=require` is safe to leave on.
# ═══════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════
# SERVICE 1 — sahamgue-api  (Python / FastAPI)
# Paste into: Render → sahamgue-api → Environment → Add from .env
# ═══════════════════════════════════════════════════════════════

# Use "staging" until you have LIVE Clerk + reCAPTCHA + Xendit keys.
# "production" enforces fail-fast validation on all of those.
ENVIRONMENT=staging
DEBUG=false

# Neon DIRECT connection (no "-pooler" in the host)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Upstash Redis — use the TLS URL (rediss://)
REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379
OTP_STORE_BACKEND=redis
RATE_LIMIT_BACKEND=redis

# Generate each: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Clerk — test keys are fine for staging; swap to pk_live_/sk_live_ for production
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Google Gemini (free ~1500 req/day on Flash) — https://aistudio.google.com
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

# Email / OTP via Resend SMTP — https://resend.com
# SMTP_FROM must be a Resend-verified domain (or onboarding@resend.dev for testing)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
SMTP_FROM=onboarding@resend.dev

# App URLs — your Vercel deployment (or custom domain)
CORS_ORIGINS=https://YOUR_APP.vercel.app
TRUSTED_HOSTS=sahamgue-api.onrender.com
PUBLIC_APP_URL=https://YOUR_APP.vercel.app
STRICT_ORIGIN_CHECK=false

# reCAPTCHA — keep disabled until you register your live domain
RECAPTCHA_ENABLED=false
GLOBAL_API_RATE_LIMIT_PER_MINUTE=300
PASSWORD_RESET_EXPIRE_MINUTES=30

# Xendit — TEST mode is free and needs no business verification
XENDIT_SECRET_KEY=xnd_development_REPLACE_ME
XENDIT_WEBHOOK_TOKEN=REPLACE_WITH_WEBHOOK_TOKEN
XENDIT_ENVIRONMENT=TEST
XENDIT_SUCCESS_URL=https://YOUR_APP.vercel.app/payment/success
XENDIT_FAILURE_URL=https://YOUR_APP.vercel.app/payment/failed


# ═══════════════════════════════════════════════════════════════
# SERVICE 2 — sahamgue-news  (Node.js / Express)
# Paste into: Render → sahamgue-news → Environment → Add from .env
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001

# Same Neon DIRECT endpoint as the Python service, but plain postgresql://
# (Prisma format). Direct endpoint is required for `prisma migrate deploy`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Same Upstash Redis URL as the Python service
REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379

# News AI enrichment — Groq free tier (14,400 req/day) — https://console.groq.com
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
AI_ENRICHMENT_PROVIDER=groq

# RSS sources scraped by the agent (comma-separated)
NEWS_SOURCES=https://www.kontan.co.id/rss/news,https://www.cnbcindonesia.com/rss,https://www.bisnis.com/rss,https://finance.detik.com/rss,https://www.idxchannel.com/rss

# Cron: every 15 min during IDX trading hours (08:45–16:15 WIB = 01:45–09:15 UTC)
AGENT_CRON_SCHEDULE=*/15 1-9 * * 1-5
RELEVANCE_THRESHOLD=0.6
CLAUDE_BATCH_SIZE=5
DEDUP_TTL_SECONDS=1800

# Must match the Python service's JWT_SECRET_KEY (shared admin token signing)
JWT_SECRET=REPLACE_WITH_SAME_VALUE_AS_PYTHON_JWT_SECRET_KEY
