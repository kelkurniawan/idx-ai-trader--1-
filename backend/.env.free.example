# ─────────────────────────────────────────────────────────────
# Free Tier Environment Template
# Copy this to backend/.env.production and fill in the values.
#
# Providers used (all free tiers):
#   Database : Neon       https://neon.tech
#   Redis    : Upstash    https://upstash.com
#   Email    : Resend     https://resend.com
#   Auth     : Clerk      https://clerk.com
#   AI       : Gemini     https://aistudio.google.com
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=production
DEBUG=false

# ── Database (Neon) ───────────────────────────────────────────
# Use the direct connection string (not the pooled one) for Python/SQLAlchemy.
# Format: postgresql+asyncpg://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/sahamgue?sslmode=require
DATABASE_URL=postgresql+asyncpg://REPLACE_ME@REPLACE_ME.neon.tech/sahamgue?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────
# Use the TLS URL (starts with rediss://)
REDIS_URL=rediss://default:REPLACE_ME@REPLACE_ME.upstash.io:6379
OTP_STORE_BACKEND=redis
RATE_LIMIT_BACKEND=redis

# ── Security ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Clerk (create a Production instance at clerk.com) ─────────
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
CLERK_JWKS_URL=

# ── reCAPTCHA (register your domain at google.com/recaptcha) ──
RECAPTCHA_SECRET_KEY=REPLACE_WITH_LIVE_SECRET
RECAPTCHA_SITE_KEY=REPLACE_WITH_LIVE_SITE_KEY
RECAPTCHA_ENABLED=true

# ── Email / OTP (Resend) ──────────────────────────────────────
# SMTP_FROM must use a domain you verified in Resend (or use onboarding@resend.dev for testing)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
SMTP_FROM=noreply@yourdomain.com

# ── AI (Google Gemini Flash — free 1 500 req/day) ────────────
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# ── App URLs (use your Vercel URL or custom domain) ───────────
PUBLIC_APP_URL=https://YOUR_APP.vercel.app
CORS_ORIGINS=https://YOUR_APP.vercel.app
TRUSTED_HOSTS=sahamgue-api.onrender.com
STRICT_ORIGIN_CHECK=true
GLOBAL_API_RATE_LIMIT_PER_MINUTE=300
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Xendit (payment gateway — use TEST for free testing) ──────
# Register at https://dashboard.xendit.co
# Switch XENDIT_ENVIRONMENT to LIVE when ready to accept real payments
XENDIT_SECRET_KEY=REPLACE_WITH_XENDIT_SECRET
XENDIT_WEBHOOK_TOKEN=REPLACE_WITH_WEBHOOK_TOKEN
XENDIT_ENVIRONMENT=LIVE
XENDIT_SUCCESS_URL=https://YOUR_APP.vercel.app/payment/success
XENDIT_FAILURE_URL=https://YOUR_APP.vercel.app/payment/failed

# ── Ops alerting (optional — point to Slack/Discord webhook) ──
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_BEARER=

# ─────────────────────────────────────────────────────────────
# Node.js news backend vars (set these on your Render Node service)
# ─────────────────────────────────────────────────────────────

# Use the pooled Neon connection string for Prisma
# Format: postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/sahamgue?sslmode=require
# NODE_DATABASE_URL=postgresql://REPLACE_ME@REPLACE_ME-pooler.neon.tech/sahamgue?sslmode=require

# Pick one AI provider for news enrichment (Groq is free-tier friendly)
# GROQ_API_KEY=REPLACE_WITH_GROQ_KEY              # free — 14 400 req/day
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY    # paid
# DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY      # cheap
# AI_ENRICHMENT_PROVIDER=groq

# RSS sources (comma-separated)
# NEWS_SOURCES=https://www.kontan.co.id/rss/news,https://www.cnbcindonesia.com/rss,https://www.bisnis.com/rss,https://finance.detik.com/rss,https://www.idxchannel.com/rss

# Cron: every 15 min during IDX trading hours (09:00–16:00 WIB = 01:45–09:15 UTC)
# AGENT_CRON_SCHEDULE=*/15 1-9 * * 1-5
