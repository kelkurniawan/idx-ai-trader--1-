# ---------------------------------------------------------------------------
# Node.js News Microservice Dockerfile
# ---------------------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
COPY prisma ./prisma/

# Install dependencies (including dev deps for building)
RUN npm install

# Generate Prisma client
RUN npx prisma generate

# Copy the rest of the source code
COPY . .

# Build typescript
RUN npm run build

# --- Production Image ---
FROM node:20-alpine

WORKDIR /app

# Copy built artifacts and dependencies
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Startup script: normalizes DATABASE_URL, scopes Prisma to the "news" schema,
# runs db push (creating only the Prisma-owned tables), then starts the server.
COPY docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x docker-entrypoint.sh

EXPOSE 3001

CMD ["sh", "./docker-entrypoint.sh"]
