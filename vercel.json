{
  "rewrites": [
    {
      "source": "/api/news/:path*",
      "destination": "https://REPLACE_NODE_BACKEND_URL/api/news/:path*"
    },
    {
      "source": "/api/agent/:path*",
      "destination": "https://REPLACE_NODE_BACKEND_URL/api/agent/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_PYTHON_BACKEND_URL/api/:path*"
    }
  ]
}
